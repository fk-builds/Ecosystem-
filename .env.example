# ── Backend server ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── SaaS / auth ───────────────────────────────────────────────────
# Where users/sessions/projects persist (":memory:" = tests/dev only)
SAAS_DATA_DIR=.data
# Optional Supabase JWT verification (access tokens as Bearer tokens)
SUPABASE_JWT_SECRET=
# Seeded demo account (Pro plan + sample project)
DEMO_EMAIL=demo@fk.ai
DEMO_PASSWORD=demo1234
# Public URL used in billing redirect URLs
PUBLIC_BASE_URL=http://localhost:3000

# ── SaaS / billing ────────────────────────────────────────────────
# Empty = demo billing (instant activation). Set both for real Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── LLM (any OpenAI-compatible endpoint) ──────────────────────────
# Real agent: set AGENT_API_KEY (OpenAI/Groq/Azure) OR run Ollama locally
# (auto-detected at http://localhost:11434/v1 — free, no key).
AGENT_API_KEY=
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4o-mini
AGENT_TEMPERATURE=0.4
AGENT_MAX_TOOL_ROUNDS=6
OLLAMA_BASE_URL=
# Embedding model used for real dense vector memory (RAG). Falls back to TF-IDF
# when no LLM endpoint is configured.
EMBEDDING_MODEL=text-embedding-3-small

# ── Database / Supabase (PostgreSQL) ──────────────────────────────
# Verify: postgresql://postgres:postgres@localhost:5432/fkbuilder
# Supabase: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
DATABASE_POOL_SIZE=5
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Vector memory (Qdrant) ────────────────────────────────────────
# Leave empty -> offline hash-embedding memory store (dev only).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=agent_memory
# Pinecone alternative (uncomment when used):
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=
# PINECONE_INDEX=agent-memory

# ── Agent tools ───────────────────────────────────────────────────
CANVAS_DEFAULT_NAME=Untitled Canvas
HTTP_TOOL_ALLOWLIST=*
HTTP_TOOL_TIMEOUT_S=10
HTTP_TOOL_MAX_BYTES=262144
EXEC_PYTHON_ENABLED=true
EXEC_PYTHON_TIMEOUT_S=8
VECTOR_MEMORY_TOP_K=5

# ── Frontend ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_WS_URL=
